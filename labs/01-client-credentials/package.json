{
  "name": "oauth2-lab-01-client-credentials",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "setup": "node .tmp/build/src/setup.js",
    "start:as": "node .tmp/build/src/authorization-server.js",
    "start:rs": "node .tmp/build/src/resource-server.js",
    "client": "node .tmp/build/src/client.js",
    "test": "npm run build && node --test .tmp/build/test/*.test.js",
    "lint": "eslint src test",
    "format:check": "prettier --check src test *.json *.mjs README.md",
    "format": "prettier --write src test *.json *.mjs README.md",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "express": "5.3.0",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
